SITE_NAME_HEADER=My Soul Is Splintered And You Hold A Fragment
SITE_MAIN_LANGUAGE=en
SITE_BASE_URL=https://my-mind-space.vercel.app/
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=DDDD (dddd) MMMM YYYY
SHOW_UPDATED_TIMESTAMP=true
NOTE_ICON_DEFAULT=Biohazard_symbol.svg
NOTE_ICON_TITLE=true
NOTE_ICON_FILETREE=true
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=true
STYLE_SETTINGS_CSS=body.css-settings-manager { --ag-blur: 0px; --ag-note-alpha: 0.9; --ag-panel-alpha: 0.2; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { }
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars is-floating-nav auto-full-screen show-ribbon outliner-plugin-dnd zoom-plugin-bls-zoom pp-pill-padding-all colored-tags css-settings-manager rowoverflow horizontal-to-vertical small-title compact-title tab-numbering tab-underline plugin-tabs basic-pathfinder-2e-layout-theme-default pathfinder-2e-action-layout-theme-default pathfinder-2e-hazard-layout-theme-default pathfinder-2e-influence-layout-theme-default pathfinder-2e-item-layout-theme-default pathfinder-2e-misc-layout-theme-default pathfinder-2e-plane-layout-theme-default pathfinder-2e-quest-layout-theme-default pathfinder-2e-settlement-layout-theme-default ag-plain-headings is-maximized
USE_FULL_RESOLUTION_IMAGES=true
THEME=https://raw.githubusercontent.com/sasecurityn/Ember-Glazz/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=false
dgPassFrontmatter=false
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowInlineTitle=false
dgShowFileTree=false
dgEnableSearch=false
dgShowToc=true
dgLinkPreview=true
dgShowTags=false
UI_BACKLINK_HEADER=Places Where This Has Been Whispered
UI_NO_BACKLINKS_MESSAGE=This Hath Been Forsaken
LOGO_HEIGHT=24